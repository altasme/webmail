{
  "name": "@altasme/webmail-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portable Cloudflare Workers/Pages backend for a real business webmail module: inbound via Email Routing, outbound via raw SMTP over cloudflare:sockets, D1-backed storage. Extracted from ClientKeeper's webmail build so future projects can import it instead of rebuilding it.",
  "license": "UNLICENSED",
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker/index.ts",
    "./worker/inbound": "./src/worker/inbound.ts",
    "./worker/parse": "./src/worker/parse.ts",
    "./access": "./src/access.ts",
    "./actions": "./src/actions.ts",
    "./address": "./src/address.ts",
    "./compose": "./src/compose.ts",
    "./config": "./src/config.ts",
    "./detail": "./src/detail.ts",
    "./drafts": "./src/drafts.ts",
    "./events": "./src/events.ts",
    "./http": "./src/http.ts",
    "./mime": "./src/mime.ts",
    "./query": "./src/query.ts",
    "./route": "./src/route.ts",
    "./sanitize": "./src/sanitize.ts",
    "./send": "./src/send.ts",
    "./sendRoute": "./src/sendRoute.ts",
    "./smtp": "./src/smtp.ts",
    "./smtpTransport": "./src/smtpTransport.ts",
    "./storage": "./src/storage.ts",
    "./store": "./src/store.ts",
    "./text": "./src/text.ts",
    "./threading": "./src/threading.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "postal-mime": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
